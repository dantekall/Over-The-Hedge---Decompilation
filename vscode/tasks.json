{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "OTH: Build & Check",
            "type": "shell",
            "command": "python3 tools/oth_helper.py",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "OTHDecomp: Clean Build Directory",
            "type": "shell",
            "command": "make",
            "args": [
                "clean"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "OTHDecomp: Validate Splat YAML & Segments",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/validate_splat.py",
                "${workspaceFolder}/splat.yaml"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": {
                "owner": "splat-linter",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^::error file=(.*?),line=(\\d+)::(.*)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                }
            }
        }
    ]
}
